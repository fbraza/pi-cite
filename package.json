{
  "name": "@fbraza/pi-cite",
  "version": "2.0.0",
  "description": "Pi extension with PubMed, Zotero, and literature search tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "literature",
    "pubmed",
    "zotero"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
